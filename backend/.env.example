DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=change-me-in-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Overridden by docker-compose.yml when running via `docker compose up`.
# Set these yourself only when running the backend outside Docker.
# DATABASE_URL=postgres://bienvenue:bienvenue@localhost:25432/bienvenue
# OIDC_RP_CLIENT_ID=bienvenue-lasuite
# OIDC_RP_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly
# OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/auth
# OIDC_OP_TOKEN_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/certs
