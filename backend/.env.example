# ==============================================================================
# Bienvenue à La Suite — Backend Environment Variables
# ==============================================================================
# Overridden by docker-compose.yml when running via `make up` or `docker compose up`.
# Customize this file only when overriding defaults or running backend locally outside Docker.
# ==============================================================================

DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver,0.0.0.0,*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
# Inside Docker:
DATABASE_URL=postgres://bienvenue:your_postgres_password@postgresql:5432/bienvenue
# Outside Docker:
# DATABASE_URL=postgres://bienvenue:your_postgres_password@localhost:25432/bienvenue

# Keycloak / ProConnect OIDC
OIDC_RP_CLIENT_ID=bienvenue-lasuite
OIDC_RP_CLIENT_SECRET=your_oidc_client_secret_here
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"

OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/auth
OIDC_OP_LOGOUT_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/logout

# Inside Docker:
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/certs
# Outside Docker:
# OIDC_OP_TOKEN_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/certs

LOGIN_REDIRECT_URL=http://localhost:3000/
LOGIN_REDIRECT_URL_FAILURE=http://localhost:3000/
LOGOUT_REDIRECT_URL=http://localhost:3000/

# External Services
LA_SUITE_FICHIERS_URL=http://127.0.0.1:8000/api/mock-suite/fichiers/users/{email}/
# LA_SUITE_FICHIERS_TOKEN=

GRIST_BASE_URL=http://grist:8484
# GRIST_API_KEY=
# GRIST_DOC_ID=
