# ==============================================================================
# Bienvenue à La Suite — Environment Variables Configuration
# ==============================================================================
# NOTE: When running with Docker (e.g. `make up` or `docker compose up`), all
# services come pre-configured with working defaults out of the box. You do NOT
# need to create a .env file unless you want to customize values or run outside Docker.
#
# To customize, copy this file to .env:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Backend Core Settings
# ------------------------------------------------------------------------------
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver,0.0.0.0,*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database
# ------------------------------------------------------------------------------
# Default inside Docker Compose network:
DATABASE_URL=postgres://bienvenue:your_postgres_password@postgresql:5432/bienvenue
# Use this when running the Django backend locally outside Docker:
# DATABASE_URL=postgres://bienvenue:your_postgres_password@localhost:25432/bienvenue

POSTGRES_DB=bienvenue
POSTGRES_USER=bienvenue
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_PORT=25432

# ------------------------------------------------------------------------------
# 3. Keycloak / ProConnect OIDC SSO
# ------------------------------------------------------------------------------
OIDC_RP_CLIENT_ID=bienvenue-lasuite
OIDC_RP_CLIENT_SECRET=your_oidc_client_secret_here
OIDC_RP_SIGN_ALGO=RS256
OIDC_RP_SCOPES="openid email profile"

# Browser-facing authorization endpoint (accessed via port 8180 from host):
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/auth
OIDC_OP_LOGOUT_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/logout

# Server-to-server token & JWKS endpoints:
# Inside Docker network:
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/certs
# When running backend outside Docker, uncomment these instead:
# OIDC_OP_TOKEN_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/token
# OIDC_OP_USER_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
# OIDC_OP_JWKS_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/certs

LOGIN_REDIRECT_URL=http://localhost:3000/
LOGIN_REDIRECT_URL_FAILURE=http://localhost:3000/
LOGOUT_REDIRECT_URL=http://localhost:3000/

# Keycloak Admin credentials for local admin console (http://localhost:8180/admin)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password

# ------------------------------------------------------------------------------
# 4. External Integrations — La Suite Fichiers (Nextcloud Drive)
# ------------------------------------------------------------------------------
# Local development uses the built-in mock endpoint:
LA_SUITE_FICHIERS_URL=http://127.0.0.1:8000/api/mock-suite/fichiers/users/{email}/
# In production, set to the sovereign Nextcloud provisioning URL:
# LA_SUITE_FICHIERS_URL=https://fichiers.numerique.gouv.fr/ocs/v1.php/cloud/users/{email}
# LA_SUITE_FICHIERS_TOKEN=your_nextcloud_bearer_token

# ------------------------------------------------------------------------------
# 5. External Integrations — Grist Relational Spreadsheet
# ------------------------------------------------------------------------------
GRIST_BASE_URL=http://grist:8484
# When running outside Docker:
# GRIST_BASE_URL=http://localhost:8585
GRIST_DEFAULT_EMAIL=manager@bienvenue.local
GRIST_IN_SERVICE=true
# Optional Grist API key and Doc ID for webhook/sync tests:
# GRIST_API_KEY=
# GRIST_DOC_ID=

# ------------------------------------------------------------------------------
# 6. React Frontend
# ------------------------------------------------------------------------------
# Target URL for Vite proxy to reach the Django BFF:
# Inside Docker Compose:
BACKEND_URL=http://backend:8000
# When running frontend outside Docker:
# BACKEND_URL=http://localhost:8000
PORT=3000
