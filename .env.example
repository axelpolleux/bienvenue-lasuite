# ==============================================================================
# Bienvenue à La Suite — Environment Configuration Template
# Copy this file to .env and adjust values as needed for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_DB=bienvenue
POSTGRES_USER=bienvenue
POSTGRES_PASSWORD=bienvenue
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
DATABASE_URL=postgres://bienvenue:bienvenue@postgresql:5432/bienvenue

# ------------------------------------------------------------------------------
# Django Backend (BFF)
# ------------------------------------------------------------------------------
DJANGO_ENVIRONMENT=development
DJANGO_DEBUG=True
# WARNING: Change DJANGO_SECRET_KEY in any non-development deployment!
DJANGO_SECRET_KEY=django-insecure-*)_o6thi#%2jx&h!_-aqhtm7@)bryd^%xw@uffc==eq%)qf^3^
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# ------------------------------------------------------------------------------
# ProConnect / Keycloak OIDC Authentication
# ------------------------------------------------------------------------------
OIDC_RP_CLIENT_ID=bienvenue-lasuite
# WARNING: Change OIDC_RP_CLIENT_SECRET in production!
OIDC_RP_CLIENT_SECRET=ThisIsAnExampleKeyForDevPurposeOnly
OIDC_OP_AUTHORIZATION_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/auth
OIDC_OP_TOKEN_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/token
OIDC_OP_USER_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/userinfo
OIDC_OP_JWKS_ENDPOINT=http://keycloak:8080/realms/bienvenue-lasuite/protocol/openid-connect/certs
OIDC_OP_LOGOUT_ENDPOINT=http://localhost:8180/realms/bienvenue-lasuite/protocol/openid-connect/logout
LOGIN_REDIRECT_URL=http://localhost:3000/
LOGOUT_REDIRECT_URL=http://localhost:3000/

# ------------------------------------------------------------------------------
# Self-Hosted Grist
# ------------------------------------------------------------------------------
GRIST_BASE_URL=http://grist:8484
GRIST_DOC_ID=kcyTujZCa1cdCqifiRhL5w
GRIST_API_KEY=grist_api_key_manager
GRIST_DEFAULT_EMAIL=manager@bienvenue.local
GRIST_SINGLE_ORG=docs-5

# ------------------------------------------------------------------------------
# Frontend (React / Vite)
# ------------------------------------------------------------------------------
BACKEND_URL=http://backend:8000
VITE_GRIST_URL=http://localhost:8585/doc/kcyTujZCa1cdCqifiRhL5w
